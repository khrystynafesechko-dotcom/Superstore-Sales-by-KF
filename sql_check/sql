SELECT *
FROM dbo.SuperStoreOrders
  
EXEC sp_help 'dbo.SuperStoreOrders';

---Total_Sales,Total_Profit, Profit_Margin
SELECT
    SUM(TRY_CONVERT(decimal(18,2),
        REPLACE(sales, ',', ''))) AS Total_Sales,
    SUM(TRY_CONVERT(decimal(18,2),
        REPLACE(profit, ',', ''))) AS Total_Profit,
    CAST(SUM(TRY_CONVERT(decimal(18,2),
            REPLACE(profit, ',', ''))) * 100.0/
        NULLIF(SUM(TRY_CONVERT(decimal(18,2),
                REPLACE(sales, ',', ''))), 0) AS decimal(10,2)) AS Profit_Margin
FROM dbo.SuperStoreOrders;



---Total Orders (unique order_id), Unique Customers, Average Order Value, Avg Discount (%), Total Quantity  
SELECT COUNT(DISTINCT order_id) AS total_orders,
COUNT(DISTINCT customer_name) AS unique_customers,
CAST(SUM(TRY_CAST(REPLACE(sales, ',', '') AS DECIMAL(18,2))) /
    NULLIF(COUNT(DISTINCT order_id), 0) AS DECIMAL(18,2)) AS avg_order_value,
ROUND(AVG(CAST(discount AS float)) * 100, 2) AS avg_discount,
SUM(quantity) AS total_quantity
FROM dbo.SuperStoreOrders;

---Sales and profit by segment 
SELECT segment,
SUM(TRY_CONVERT(decimal(18,2),
    REPLACE(sales, ',', ''))) AS Total_Sales,
SUM(TRY_CONVERT(decimal(18,2),
    REPLACE(profit, ',', ''))) AS Total_Profit
FROM dbo.SuperStoreOrders
GROUP BY segment;

---Sales by category   
SELECT category,
       SUM(TRY_CONVERT(decimal(18,2),
    REPLACE(sales, ',', ''))) AS Total_Sales
FROM dbo.SuperStoreOrders
GROUP BY category;


  


